{
  "name": "secop-dotacion-insumos",
  "version": "1.0.0",
  "private": true,
  "description": "Rastreo y monitoreo de contratos de Dotacion, Vestuario, Calzado, Insumos y EPP en SECOP II (Datos Abiertos Colombia, vista jbjy-vk9h)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "npm run build && npm start",
    "check": "node scripts/check-api.mjs",
    "check:web": "node scripts/check-web.mjs",
    "check:modes": "node scripts/check-modes.mjs",
    "check:fuentes": "node scripts/check-fuentes.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwindcss": "^4.1.11",
    "vite": "^5.4.8"
  }
}
