# ===========================================================================
# SECOP Dotación / Insumos — variables de entorno
# ===========================================================================
# Copie este archivo a `.env` en la raíz del proyecto y ajuste lo que necesite.
# `server/index.js` carga el archivo con `dotenv/config`, así que TODAS las
# variables son opcionales: a la derecha de cada una está el valor por defecto
# que aplica `server/config.js` cuando la variable no está definida (o cuando su
# valor no es numérico, en el caso de las variables numéricas).
#
# Las variables de la sección `query` son GUARDARRAÍLES: limitan el tamaño de la
# ventana de fechas y del paginado que un cliente puede pedir, porque la vista
# tiene ~6,1 millones de filas (ver `docs/NOTAS-DATOS.md`, hallazgo (f)).
# ===========================================================================

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------

# Puerto HTTP del servidor Express (y de la API /api/*).
PORT=3001

# ---------------------------------------------------------------------------
# Socrata / Datos Abiertos Colombia
# ---------------------------------------------------------------------------

# Dominio de la plataforma Socrata. No lo cambie salvo que use otro portal.
SOCRATA_DOMAIN=https://www.datos.gov.co

# Identificador de la vista (dataset) de SECOP II que consulta la aplicación.
SOCRATA_DATASET=jbjy-vk9h

# >>> App token de Socrata. OPCIONAL PERO MUY RECOMENDADO. <<<
#
# Sin token, Socrata limita las peticiones por dirección IP y una ráfaga de
# consultas (por ejemplo ~30 consultas seguidas sin caché) produce timeouts de
# más de 45s que la API traduce como 502 `upstream_error`, incluso en consultas
# que en un endpoint tranquilo tardan ~5s. Con token esos límites suben de forma
# sustancial (ver `docs/NOTAS-DATOS.md`, hallazgo (g)).
#
# Obtenga uno gratis (es inmediato) en:
#   https://www.datos.gov.co/profile/edit/developer_settings
#
# El token es un SECRETO: nunca lo exponga al navegador. El cliente Socrata lo
# envía solo desde el servidor, en la cabecera `X-App-Token`, y la API pública
# únicamente informa si está configurado (`hasAppToken` en /api/health).
SOCRATA_APP_TOKEN=

# Tiempo máximo de espera (ms) de UNA petición a Socrata antes de abortarla.
# La espera peor para el usuario es timeout * (retries + 1) + backoff, así que
# este valor se multiplica: con 30000 y 1 reintento, ~1 minuto como máximo.
SOCRATA_TIMEOUT_MS=30000

# Reintentos adicionales ante 429/5xx o timeout (0 = sin reintentos).
SOCRATA_RETRIES=1

# Filas por página al exportar CSV/JSON (tamaño de cada petición de exportación).
SOCRATA_PAGE_SIZE=5000

# ---------------------------------------------------------------------------
# Caché en memoria (TTL en milisegundos)
# ---------------------------------------------------------------------------
# Las agregaciones y las páginas cuestan entre 0,3s y 4s, así que la caché es
# agresiva a propósito: es lo que evita caer en el límite por IP del hallazgo (g).

# TTL de los resultados de búsqueda (búsquedas y páginas de contratos). 3 min.
CACHE_SEARCH_TTL_MS=180000

# TTL del resumen del tablero (KPIs, series y topes). 10 min.
CACHE_SUMMARY_TTL_MS=600000

# TTL de las listas de opciones de los filtros (departamentos, ciudades,
# estados, modalidades, sectores, tipos de contrato). 6 horas.
CACHE_FACETS_TTL_MS=21600000

# Número máximo de entradas por caché antes de desalojar las más antiguas.
CACHE_MAX_ENTRIES=300

# ---------------------------------------------------------------------------
# Guardarraíles de consulta
# ---------------------------------------------------------------------------

# Ventana de fechas por defecto (días) cuando el cliente no envía `from`/`to`.
# El aplicativo está acotado a los contratos de los 2 ÚLTIMOS AÑOS.
DEFAULT_WINDOW_DAYS=730

# Ventana máxima (días) que se permite consultar. Mismo tope de 2 años: el filtro
# estricto responde 730 días en ~2,9s. Las peticiones que lo exceden se RECORTAN,
# no se rechazan (ver `docs/NOTAS-DATOS.md`, hallazgo (f)).
MAX_WINDOW_DAYS=730

# Filas por página por defecto en la tabla de resultados.
DEFAULT_PAGE_SIZE=25

# Filas por página máximas que un cliente puede pedir en la tabla.
MAX_PAGE_SIZE=200

# Tope de filas que se descargan en una exportación CSV/Excel/JSON.
EXPORT_MAX_ROWS=20000

# Ventana (días) sobre la que se calculan las opciones de los filtros (facets).
# Cada facet es un `group by` de varios segundos, por eso se calcula amplio y se
# cachea 6 horas. Coincide con el alcance de 2 años del aplicativo.
FACET_WINDOW_DAYS=730

# Precalentar en segundo plano la caché al arrancar (resumen, primera página de
# contratos y opciones de filtros). Con la ventana de 2 años la primera carga en
# frío encadena varias agregaciones de ~3s; precalentando, el primer usuario ya
# encuentra la respuesta en caché. Ponga `false` para desactivarlo.
WARMUP_ON_START=true

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------

# Entorno de ejecución. Sin definir se asume desarrollo; `npm start` la fija en
# `production` (cross-env), lo que hace que el servidor sirva `client/dist`.
# NODE_ENV=production
